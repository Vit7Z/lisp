;;;;///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
;;;;подпрограмма вывода в спцф                   //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
(defun spcf-101-01-exec-mech-pem-b

( / cntr-1 dlt-y nmbr-ln pnt-ins str-0 str-1 str-2 str-3 str-4 str-5 str-6 str-61 str-99 str-tmp x-pnt-ins y-pnt-ins y-pnt-ins-1)

(setq cntr-1 0 ;счетчик
);setq

(repeat (length list-902)
	(setq str-tmp (nth cntr-1 list-902)
				str-0 (cdr (assoc 0 str-tmp))
				str-1 (cdr (assoc 1 str-tmp))
				str-2 (cdr (assoc 2 str-tmp))
				str-3 (cdr (assoc 3 str-tmp))
				str-4 (cdr (assoc 4 str-tmp))
				str-5 (cdr (assoc 5 str-tmp))
				str-6 (cdr (assoc 6 str-tmp))
				str-99 (cdr (assoc 99 str-tmp))
	);setq
	
	(setvar "osmode" 6199)
	(setq pnt-ins		(getpoint "\nУкажите точку вставки\n")
	  		x-pnt-ins (nth 0 pnt-ins)
	 			y-pnt-ins (nth 1 pnt-ins)
	  		y-pnt-ins-1 y-pnt-ins
	  		dlt-y 8
	); setq
	
	(101-empt-lin-spcf)
	(setvar "osmode" 0)
	(setvar "cmdecho" 0)

	;обработка данных
	(cond
		((= str-5 "Круг, диам. 44мм") (setq str-5 "круглого сечения, диаметром 44мм"));=
		((= str-5 "Квадрат, сторона 19мм") (setq str-5 "квадратного сечения, сторона 19мм"));=
	);cond

	(cond
		((= str-6 "М Блок концевых выключателей") (setq str-6 "М" str-61 "- блок концевых выключателей"));=
		((= str-6 "Р Реостатный датчик сигнализации положения") (setq str-6 "Р" str-61 "- реостатный датчик сигнализации положения"));=
		((= str-6 "И Индуктивный датчик сигнализации положения") (setq str-6 "И" str-61 "- индуктивный датчик сигнализации положения"));=
		((= str-6 "У Токовый датчик сигнализации положения") (setq str-6 "У" str-61 "- токовый датчик сигнализации положения"));=
		
		((= str-6 "КИМ1-3-А-380 Аналоговое управление") (setq str-6 "Е" str-61 "- контроллер КИМ1-3-А-380 (аналоговое управление)"));=
		((= str-6 "КИМ1-3-Д-380 Дискретное управление") (setq str-6 "Е" str-61 "- контроллер КИМ1-3-А-380 (дискретое управление)"));=
		((= str-6 "КИМ1-3-С-380 Сетевое управление") (setq str-6 "Е" str-61 "- контроллер КИМ1-3-А-380 (сетевое управление)"));=
		((= str-6 "КИМ1-3-Т-380 Дискретно-сетевое управление") (setq str-6 "Е" str-61 "- контроллер КИМ1-3-А-380 (дискретно-сетевое управление)"));=
	);cond
	
	(setq nmbr-ln 10);setq
	
	(1000-delete-items-spcf nmbr-ln x-pnt-ins y-pnt-ins);удаление предыдущей записи
	
	(command "_text" "_ML" (list (+ x-pnt-ins 1) (- (- y-pnt-ins (* dlt-y 0)) 4)) 2.5 0 "Электрический исполнительный механизм")
	(command "_text" "_ML" (list (+ x-pnt-ins 5) (- (- y-pnt-ins (* dlt-y 1)) 4)) 2.5 0 (strcat "- номинальный крутящий момент на выходном валу " str-1 "Нм"))
	(command "_text" "_ML" (list (+ x-pnt-ins 5) (- (- y-pnt-ins (* dlt-y 2)) 4)) 2.5 0 (strcat "- частота вращения выходного вала " str-2 "об/мин"))
	(command "_text" "_ML" (list (+ x-pnt-ins 5) (- (- y-pnt-ins (* dlt-y 3)) 4)) 2.5 0 (strcat "- число оборотов до открытия (закрытия) " str-3))
	(command "_text" "_ML" (list (+ x-pnt-ins 5) (- (- y-pnt-ins (* dlt-y 4)) 4)) 2.5 0 (strcat "- выходной вал " str-5))
