;;;;/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
;;;;подпрограмма вывода в ПЭ                   //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
(defun le-101-01-exec-mech-pem-b

( / cntr-1 dlt-y nmbr-ln pnt-ins str-0 str-6 str-61 str-tmp x-pnt-ins y-pnt-ins y-pnt-ins-1)

(setq cntr-1 0 ;счетчик
);setq

(repeat (length list-902)
	(setq str-tmp (nth cntr-1 list-902)
				str-0 (cdr (assoc 0 str-tmp))
				str-6 (cdr (assoc 6 str-tmp))
	);setq
	
;(princ "\n         str-tmp = ") (princ str-tmp);Erase_DV
;(getstring "\nPress Enter to continue...");Erase_DV
	
	(cond
		((= str-6 "М Блок концевых выключателей") (setq str-6 "М" str-61 "с блоком концевых выключателей"));=
		((= str-6 "Р Реостатный датчик сигнализации положения") (setq str-6 "Р" str-61 "с реостатным датчиком сигнализации положения"));=
		((= str-6 "И Индуктивный датчик сигнализации положения") (setq str-6 "И" str-61 "с индуктивным датчиком сигнализации положения"));=
		((= str-6 "У Токовый датчик сигнализации положения") (setq str-6 "У" str-61 "с токовым датчиком сигнализации положения"));=
		
		((= str-6 "КИМ1-3-А-380 Аналоговое управление") (setq str-6 "Е" str-61 "с контроллером КИМ1-3-А-380 (аналоговое управление)"));=
		((= str-6 "КИМ1-3-Д-380 Дискретное управление") (setq str-6 "Е" str-61 "с контроллером КИМ1-3-Д-380 (дискретое управление)"));=
		((= str-6 "КИМ1-3-С-380 Сетевое управление") (setq str-6 "Е" str-61 "с контроллером КИМ1-3-С-380 (сетевое управление)"));=
		((= str-6 "КИМ1-3-Т-380 Дискретно-сетевое управление") (setq str-6 "Е" str-61 "с контроллером КИМ1-3-Т-380 (дискретно-сетевое управление)"));=
	);cond

	(setvar "osmode" 6199)
	(setq pnt-ins		(getpoint "\nУкажите точку вставки\n")
  			x-pnt-ins (nth 0 pnt-ins)
 				y-pnt-ins (nth 1 pnt-ins)
  			y-pnt-ins-1 y-pnt-ins
  			dlt-y 8
  			nmbr-ln 3
	);setq
	
	(100-empt-lin-le)
	(setvar "osmode" 0)
	(setvar "cmdecho" 0)
		
	(1000-delete-items-le nmbr-ln x-pnt-ins y-pnt-ins)
			
	(command "_text" "_ML" (list (+ x-pnt-ins 1) (- (- y-pnt-ins (* dlt-y 0)) 4)) 2.5 0 (strcat "Электрический исполнительный механизм ПЭМ-" str-0 str-6 ","))
	(command "_text" "_ML" (list (+ x-pnt-ins 1) (- (- y-pnt-ins (* dlt-y 1)) 4)) 2.5 0 (strcat str-61))
	
	(setq cntr-1 (1+ cntr-1);счетчик
	);setq
	
	(repeat nmbr-ln
  	(command "_insert" "пэ-пустая-строка" "_X" 1 "_Y" 1 "_Z" 1 "_R" 0 (list x-pnt-ins y-pnt-ins-1))
  	(setq y-pnt-ins-1 (- y-pnt-ins-1 8)
  	);setq
	);repeat
);repeat

(princ)
)
