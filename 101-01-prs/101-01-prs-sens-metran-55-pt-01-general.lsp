;;;;////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
;;;;подпрограмма вывода в спцф                   ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
(defun tmp-spcf-101-metran-55

( / cntr-1 dlt-y kol nmbr-ln pnt-ins str-txt tmp tmp-1 tmp-10 tmp-10-1 tmp-1-1 tmp-2 tmp-3 tmp-3-2 tmp-4 tmp-4-2 tmp-5 tmp-5-2 tmp-6 tmp-6-2 tmp-7 tmp-7-2 tmp-8 tmp-8-2 
tmp-9 tmp-9-1 tmp-99 x-pnt-ins y-pnt-ins y-pnt-ins-1)

(setq cntr-1 0
			nmbr-ln 7
			kol 4
);setq

(repeat (length list-902)
	(setq tmp (nth cntr-1 list-902)
				tmp-1 (cdr (assoc 1 tmp))
				tmp-2 (cdr (assoc 2 tmp))
				tmp-3 (cdr (assoc 3 tmp))
				tmp-4 (cdr (assoc 4 tmp))
				tmp-5 (cdr (assoc 5 tmp))
				tmp-6 (cdr (assoc 6 tmp))
				tmp-7 (cdr (assoc 7 tmp))
				tmp-8 (cdr (assoc 8 tmp))
				tmp-9 (cdr (assoc 9 tmp))
				tmp-10 (cdr (assoc 10 tmp))
				tmp-99 (cdr (assoc 99 tmp))
	);setq
	
	(setvar "osmode" 6199)
	
	(setq pnt-ins		(getpoint "\nУкажите точку вставки\n")
	  		x-pnt-ins (nth 0 pnt-ins)
	 			y-pnt-ins (nth 1 pnt-ins)
	  		y-pnt-ins-1 y-pnt-ins
	  		dlt-y 8
	);setq
	
	(101-empt-lin-spcf)

	;////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	(setq tmp-1-1
		(cond
			((wcmatch tmp-1 "*ДА") "измерение абсолютного давления");=
			((wcmatch tmp-1 "*ДИ") "измерение избыточного давления");=
			((wcmatch tmp-1 "*ДИВ") "измерение давления-разряжения");=
		);cond
	);setq
	
	
	(setq tmp-3-2
		(cond
			((= "0,06 разр" tmp-3) "0,06");=
			((= "0,1 разр" tmp-3) "0,1");=
		);cond
	);setq
 
	(setq tmp-4-2
		(cond
			((= "МП" tmp-4) "-МП");=
			((= "АП" tmp-4) "");=
		);cond
	);setq
	
	(cond
		((= "Нет" tmp-5) 
			(setq tmp-5-2 ""
						nmbr-ln (- nmbr-ln 1)
						kol 3
			);setq
		);=
		((= "Да" tmp-5)
			(progn
				(setq tmp-5-2 "-К"
							kol 4
				);setq
				(command "_text" "_ML" (list (+ x-pnt-ins 5) (- (- y-pnt-ins (* dlt-y 3)) 4)) 2.5 0 "- для работы с кислородом")
			);progn
		);=
	);cond
	
	(setq tmp-6-2
		(cond
			((= "УХЛ 3.1 (+5...+50)" tmp-6) "t1");=
			((= "УХЛ 3.1 (-10...+50)" tmp-6) "t2");=
			((= "УХЛ 3.1 (+5...+70)" tmp-6) "t3");=
			((= "У2 (-30...+50)" tmp-6) "t4");=
			((= "У2 (-42...+50)" tmp-6) "t5");=
			((= "У2 (-42...+70)" tmp-6) "t6");=
			((= "Т3 (-10...+55)" tmp-6) "t7");=
			((= "Т3 (-25...+70)" tmp-6) "t8");=
			((= "Т3 (-25...+55)" tmp-6) "t9");=
		);cond
	);setq

  (if (= "МП" tmp-4)
  	(setq tmp-7-2
			(cond
				((= "0,5" tmp-7) "050");=
				((= "0,25" tmp-7) "025");=
				((= "0,15" tmp-7) "015");=
			);cond
		);setq
	);if
	  
  (if (= "АП" tmp-4) (setq tmp-7-2 tmp-7));if

	(setq tmp-8-2
		(cond
			((= "4-20" tmp-8) "42");=
			((= "0-5" tmp-8) "05");=
			((= "0-20" tmp-8) "02");=
		);cond
	);setq

	(setq tmp-9-1
		(cond
			((= "С" tmp-9) "- cальниковый ввод, для кабеля диаметром не более 10мм.");=
			((= "С2" tmp-9) "- cальниковый ввод с фиксацией кабеля");=
			((= "ШР" tmp-9) "- штепсельный разъем");=
		);cond
	);setq

	(setq tmp-10-1
		(cond
			((= "М20" tmp-10) "- ниппель с накидной гайкой М20х1,5");=
			((= "М20-Кр" tmp-10) "- ниппель с накидной гайкой М20х1,5, кронштейн");=
			((= "М12" tmp-10) "- штуцер М12х1,5");=
			((= "М12-Кр" tmp-10) "- штуцер М12х1,5, кронштейн");=
			((= "КБуст" tmp-10) "- клапанный блок, установленный на датчик давления");=
		);cond
	);setq
	
	(1000-delete-items-spcf nmbr-ln pnt-ins)
	(1000-delete-items-spcf-crtf nmbr-ln pnt-ins)
				
	(setq str-txt (strcat tmp-1 "-" tmp-2 tmp-5-2 tmp-4-2 "-" tmp-6-2 "-" tmp-7-2 "-" tmp-3 "МПа-" tmp-8-2 "-" tmp-9 "/" tmp-10));setq
			
	(command "_text" "_ML" (list (+ x-pnt-ins 1) (- (- y-pnt-ins (* dlt-y 0)) 4)) 2.5 0 "Датчик давления")
	(command "_text" "_ML" (list (+ x-pnt-ins 5) (- (- y-pnt-ins (* dlt-y 1)) 4)) 2.5 0 (strcat "- " tmp-1-1 ", эл. преобразователь " tmp-4))
	(command "_text" "_ML" (list (+ x-pnt-ins 5) (- (- y-pnt-ins (* dlt-y 2)) 4)) 2.5 0 (strcat "- климатическое исполнение " tmp-6))
	(command "_text" "_ML" (list (+ x-pnt-ins 5) (- (- y-pnt-ins (* dlt-y kol)) 4)) 2.5 0 (strcat "- предел допускаемой осн. погрешности " tmp-7 "%, вых. сигнал " tmp-8 "мА"))
	(command "_text" "_ML" (list (+ x-pnt-ins 5) (- (- y-pnt-ins (* dlt-y (+ 1 kol))) 4)) 2.5 0 tmp-9-1)
	(command "_text" "_ML" (list (+ x-pnt-ins 5) (- (- y-pnt-ins (* dlt-y (+ 2 kol))) 4)) 2.5 0 tmp-10-1)
	;
	(split-str-parts-spcf-60-01 str-txt nil pnt-ins)
	;
	(print-number-certificate "№34341" pnt-ins)

	(repeat nmbr-ln
  	(command "_insert" "зс-пустая-строка" "_X" 1 "_Y" 1 "_Z" 1 "_R" 0 (list x-pnt-ins y-pnt-ins-1))
  	(setq y-pnt-ins-1 (- y-pnt-ins-1 8));setq
	);repeat
								
	(command "_text" "_MC" (list (+ x-pnt-ins 247.5) (- (- y-pnt-ins (* dlt-y 0)) 4)) 2.5 0 "ПГ \"Метран\",")
	(command "_text" "_MC" (list (+ x-pnt-ins 247.5) (- (- y-pnt-ins (* dlt-y 1)) 4)) 2.5 0 "г. Челябинск")	
	(command "_text" "_MC" (list (+ x-pnt-ins 280) (- (- y-pnt-ins (* dlt-y 0)) 4)) 2.5 0 "шт.")

	(command "_text" "_MC" (list (+ x-pnt-ins 322.5) (- (- y-pnt-ins (* dlt-y 0)) 4)) 2.5 0 tmp-99)
 
	(setq cntr-1 (+ cntr-1 1));setq
);repeat

(princ)
)
