;;;;подпрограмма вывода в ПЭ                   /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
(defun tmp-le-101-metran-55

( / cntr-1 dlt-y nmbr-ln pnt-ins tmp tmp-1 tmp-2 tmp-3 tmp-8 x-pnt-ins y-pnt-ins y-pnt-ins-1)

(setq cntr-1 0);setq

(repeat (length list-902)
	(setq tmp (nth cntr-1 list-902)
				tmp-1 (cdr (assoc 1 tmp))
				tmp-2 (cdr (assoc 2 tmp))
				tmp-3 (cdr (assoc 3 tmp))
				tmp-8 (cdr (assoc 8 tmp))
	);setq
		
	(setvar "osmode" 6199)
	
	(setq pnt-ins (getpoint "\nУкажите точку вставки\n")
				str-txt (strcat "Датчик давления " tmp-1 " модель " tmp-2 ", пределы изм. " tmp-3 "МПа, выходной сигнал " tmp-8 "мА")
				str-txt-01 nil
	);setq
	
	(split-str-parts-le-110-01 str-txt str-txt-01 pnt-ins)

	(setq cntr-1 (1+ cntr-1));setq
);repeat

(princ)
)
