;;;;/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
;;;;подпрограмма вывода в ПЭ                   //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
(defun tmp-le-101-01-press-dm-2005

( / cntr-1 pnt-ins str-701 str-702 str-tmp str-tmp-1 str-tmp-2 str-tmp-3 str-tmp-4 str-tmp-7)

(setq cntr-1 0);setq

(repeat (length list-902)
	(setq str-tmp (nth cntr-1 list-902)
				str-tmp-1 (cdr (assoc 1 str-tmp))
				str-tmp-2 (cdr (assoc 2 str-tmp))
				str-tmp-3 (cdr (assoc 3 str-tmp))
				str-tmp-4 (cdr (assoc 4 str-tmp))
				str-tmp-7 (cdr (assoc 7 str-tmp))
	);setq

	(setvar "osmode" 6199)
	
	(setq pnt-ins		(getpoint "\nУкажите точку вставки\n"));setq
	
	(if (= "ДМ 2005" str-tmp-1)
		(setq str-701 (strcat "Манометр электроконтактный ДМ 2005, пределы изм. " str-tmp-4 str-tmp-3 ", класс точности " str-tmp-2 ", исп. контактов " str-tmp-7)
					str-702 nil
		);setq
	);if

	(split-str-parts-le-01-general str-701 str-702 pnt-ins);

	(setq cntr-1 (1+ cntr-1));setq

);repeat

(princ)
)
