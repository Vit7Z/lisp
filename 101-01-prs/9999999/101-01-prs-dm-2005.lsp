(defun tmp-filling-fields-101-01-press-dm-2005

( / str-01 str-02 str-03 str-04 str-05 str-06 str-07 str-902 str-99 swtch)

;заполняем поле "выбрано"
(setq str-01 (nth (atoi (get_tile "txt-01")) list-01)
			str-02 (nth (atoi (get_tile "txt-02")) list-02)
			str-03 (nth (atoi (get_tile "txt-03")) list-03)
			str-04 (nth (atoi (get_tile "txt-04")) list-04)
			str-05 (nth (atoi (get_tile "txt-05")) list-05)
			str-06 (nth (atoi (get_tile "txt-06")) list-06)
			str-07 (nth (atoi (get_tile "txt-07")) list-07)
);setq

(if (/= swtch nil) (setq list-902 (reverse list-902)));if

(setq str-99 "0,9");setq

(setq str-902 (list (cons 1 str-01) (cons 2 str-02) (cons 3 str-03) (cons 4 str-04) (cons 5 str-05) (cons 6 str-06) (cons 7 str-07) (cons 99 str-99))
  				list-902 (vl-list* str-902 list-902);список характеристик для спецификации
  				list-901 (vl-list* (strcat str-01 "  "
  																 	 str-04 str-03 "  "
  																 	 str-05 "  " 
  																 	 str-06 "  "
  																 	 "Класс точности " str-02 "  "
  																 	 "Исп. контактов " str-07) list-901)
);setq

(setq list-902 (reverse list-902));setq

(list-filling "txt-901" (reverse list-901))

(princ)
)
