;/////// ************************************************************ //////////////////////////////////////////////////////////////////
;/////// перфоизделия в СО                                            //////////////////////////////////////////////////////////////////
;/////// ************************************************************ //////////////////////////////////////////////////////////////////
(defun 101-08-punched

( / adoc dcl-id list-01 list-02 list-99 str-01 type-list)

(vl-load-com)
(vla-startundomark (setq adoc (vla-get-activedocument (vlax-get-acad-object))));start undo

(setq list-01 (list "Швеллер перфорированный" 
      							"Уголок перфорированный" 
      							"Полоса перфорированная")
      list-901 nil
      list-902 nil
      
			str-01 nil
);setq

(txt-01-101-08-punched)

(if (< (setq dcl-id (load_dialog "dia-101-08-punched.dcl")) 0) ;ищем диалог
		(progn
			(alert "Не найден dcl-файл")
			(exit)
		);progn
);if

(if (not (new_dialog "dia_101_08_punched" dcl-id))
		(exit)
);if

(list-filling "txt-01" list-01)
(list-filling "txt-02" list-02)
(list-filling "txt-99" list-99)

(set_tile "txt-01" "0")
(set_tile "txt-02" "0")
(set_tile "txt-99" "0")

(action_tile "txt-01"
  (strcat "(txt-01-101-08-punched)");strcat
);action_tile

(action_tile "txt-02"
  (strcat "(set_tile \"txt-99\" $value)");srcat
);action_tile

(action_tile "but1"
  (strcat "(but1-101-08-punched)");strcat
);action_tile

(action_tile "but2"
  (strcat "(setq type-list \"le\")"
          "(done_dialog)"
  );strcat
);action_tile

(action_tile "but3"
  (strcat "(setq type-list \"spcf\")"
          "(done_dialog)"
  );strcat
);action_tile

(action_tile "but4"
  (strcat "(setq type-list \"lecgv\")"
          "(done_dialog)"
  );strcat
);action_tile

(action_tile "accept"
  (strcat "(done_dialog)"
          "(exit)"
  );strcat
);action_tile

(start_dialog)
(unload_dialog dcl-id)

(cond
	((= type-list "le") (le-101-08-punched));=
	((= type-list "spcf") (spcf-101-08-punched));=
	((= type-list "lecgv") (lecgv-101-08-punched));=
);if

(setvar "osmode" 6199)
(setvar "cmdecho" 1)
(vla-endundomark adoc)
(princ)
)
;/////// ************************************************************ ///////////////////////////////////////////////////////////////////////////////////////////////////////////
;/////// конец программы                                             ////////////////////////////////////////////////////////////////////////////////////////////////////////////
;/////// ************************************************************ ///////////////////////////////////////////////////////////////////////////////////////////////////////////

;;;;/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
;;;;/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
(defun txt-01-101-08-punched

(/)

(if (= nil str-01) 
	(setq str-01 (nth 0 list-01))
	(setq str-01 (nth (atoi (get_tile "txt-01")) list-01))
);if

(if (= "Швеллер перфорированный" str-01)
  (progn
		(setq list-02 (list "ШП 32х16х2000" "ШП 60х35х2000")
					list-99 (list "1,6" "3,1")
		);setq
		(set_tile "ptxt-022" "(ШхВхД, мм)")
  );progn
);if

(if (= "Уголок перфорированный" str-01)
  (progn
		(setq list-02 (list "УП 35х25х2000" "УП 35х35х2000" "УП 42х25х2000" "УП 60х40х2000" "УП 60х60х2000")
					list-99 (list "1,3" "1,5" "1,3" "2,7" "3,1")
		);setq
		(set_tile "ptxt-022" "(ШхВхД, мм)")
  );progn
);if

(if (= "Полоса перфорированная" str-01)
  (progn
     (setq list-02 (list "ПП 20х2000" "ПП 30х2000" "ПП 40х2000" "ПП 130х2000" "ПП 190х2000" "ПП 270х2000")
     			 list-99 (list "2,2" "2,6" "3,0" "3,1" "3,3" "3,7")
     );setq
		(set_tile "ptxt-022" "(ШхД, мм)")
  );progn
);if

(list-filling "txt-02" list-02)
(list-filling "txt-99" list-99)

(set_tile "txt-02" "0")
(set_tile "txt-99" "0")

(princ)
)
;;;;/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
;;;;/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

;;;;/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
;;;;/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
(defun but1-101-08-punched

( / str-01 str-02 str-902 str-99 swtch)

(setq str-01 (nth (atoi (get_tile "txt-01")) list-01)
			str-02 (nth (atoi (get_tile "txt-02")) list-02)
			str-99 (nth (atoi (get_tile "txt-99")) list-99)
      swtch list-901
);setq

(if (/= swtch nil) (setq list-902 (reverse list-902)));if

(setq list-901 (vl-list* (strcat str-01 "  " str-02) list-901));setq

(setq str-902 (list (cons 1 str-01) (cons 2 str-02) (cons 99 str-99))
			list-902 (vl-list* str-902 list-902)
);setq

(setq list-902 (reverse list-902));setq

(list-filling "txt-901" (reverse list-901))

(princ)
)
