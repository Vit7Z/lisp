;;;;/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

;/////// ************************************************************ ///////////////////////////////////////////////////////////////////////////////////////////////////////////
;/////// вывод в ПЭ                                                   ///////////////////////////////////////////////////////////////////////////////////////////////////////////
(defun le-101-08-punched

( / cntr-1 pnt-ins str-01 str-02 str-702 str-tmp str-txt)

(setq cntr-1 0);setq

(setvar "textstyle" "Standard")

(repeat (length list-902)
	(setq str-tmp (nth cntr-1 list-902)
				str-01 (cdr (assoc 1 str-tmp))
				str-02 (cdr (assoc 2 str-tmp))
				str-702 nil
	);setq

	(setvar "osmode" 6199)
	
	(setq pnt-ins		(getpoint "\nУкажите точку вставки\n"));setq

	(if (or (= str-01 "Швеллер перфорированный")
					(= str-01 "Уголок перфорированный"));
		(setq str-txt (strcat str-01 " " str-02 " (ШхВхД, мм)"))		
	);if

	(if (= str-01 "Полоса перфорированная")
		(setq str-txt (strcat str-01 " " str-02 " (ШхД, мм)"))		
	);if
	
	(split-str-parts-le-01-general str-txt str-702 pnt-ins "**1**");
	
	(setq cntr-1 (1+ cntr-1));setq
);repeat

(princ)
)
;;;;/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
;;;;/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


;;;;////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
;;;;подпрограмма вывода в спцф                   ///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
(defun spcf-101-08-punched

( / cntr-1 pnt-ins str-01 str-02 str-022 str-701 str-702 str-702-01 str-99 str-crtf str-manufact str-order str-tmp str-unit)

(setq cntr-1 0);setq

(repeat (length list-902)
	(setq str-tmp (nth cntr-1 list-902)
				str-01 (cdr (assoc 1 str-tmp))
				str-02 (cdr (assoc 2 str-tmp))
				str-99 (cdr (assoc 99 str-tmp))
	);setq
	
	(setvar "osmode" 6199)
	
	(setq pnt-ins (getpoint "\nУкажите точку вставки\n")
				str-022 (substr str-02 4)
	);setq


	;/////////////////////////////////////////////////////////////////////////////////////////////////
	(cond 
		((or (= str-01 "Швеллер перфорированный") (= str-01 "Уголок перфорированный"));
			(setq str-702-01 (strcat "размеры (ШхВхД) " str-022 "мм"))
		);=
	
		((= str-01 "Полоса перфорированная")
			(setq str-702-01 (strcat "размеры (ШхД) " str-022 "мм"))
		);=
	);cond
	
	(setq str-701 str-01	
				str-702 (list (cons 1 str-702-01));list
				str-order (list (cons 1 str-02) 
												(cons 2 " ") 
												(cons 3 "ТУ36.22.21.00.021-91"));list
				str-manufact "ООО \"ЗЭМИ\", г. Москва"				
				str-unit "шт."				
				str-crtf nil
	);setq
	
	(split-str-parts-spcf-01-general str-701 str-702 str-order str-manufact str-unit str-99 str-crtf pnt-ins);	
 
	(setq cntr-1 (+ cntr-1 1));setq
);repeat

(princ)
)
;;;;/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
;;;;/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


;/////// ************************************************************ ///////////////////////////////////////////////////////////////////////////////////////////////////////////
;/////// вывод в ПЭ чро                                               ///////////////////////////////////////////////////////////////////////////////////////////////////////////
(defun lecgv-101-08-punched

( / cntr-1 dlt-y pnt-ins str-01 str-02 str-701 str-702 str-703 str-99 str-tmp str-txt x-pnt-ins y-pnt-ins)

(setq cntr-1 0
			str-703 nil
);setq

(setvar "textstyle" "Standard")

(repeat (length list-902)
	(setq str-tmp (nth cntr-1 list-902)
				str-01 (cdr (assoc 1 str-tmp))
				str-02 (cdr (assoc 2 str-tmp))
				str-99 (cdr (assoc 99 str-tmp))
	);setq

	(setvar "osmode" 6199)
	
	(setq pnt-ins (getpoint "\nУкажите точку вставки\n"));setq
	
	;;;;;;;;;///////////////////////////////////////////////////////////////////////////////
	(if (or (= str-01 "Швеллер перфорированный") (= str-01 "Уголок перфорированный"));
		(setq str-701 (strcat str-01 " " str-02 " (ШхВхД, мм)")
					
					str-702 "ТУ36.22.21.00.021-91"
		);setq
	);if

	(if (= str-01 "Полоса перфорированная")
		(setq str-txt (strcat str-01 " " str-02 " (ШхД, мм)"))		
	);if
	
	(split-str-parts-lecgv-01-general str-701 str-702 str-703 str-99 pnt-ins);
		
	(setq cntr-1 (1+ cntr-1));setq
);repeat

(princ)
)
