(defun 01-spds-stamp-55mm-spcf-create-rectangle

(sign-close num-side layer pnt-1 pnt-2 pnt-3 pnt-4 sign-thik /)
    
(setq rectangle-tmp
  (entmakex
    (list
      '(0 . "LWPOLYLINE")
      '(100 . "AcDbEntity")
      '(100 . "AcDbPolyline")
      (cons 70 sign-close) ;замкнутость
      (cons 90 num-side) ;числ сторон
      '(43 . 0.0)
      (cons 8 layer);слой
      (cons 10  pnt-1);точки вершин
      (cons 10  pnt-2)
      (cons 10  pnt-3)
      (cons 10  pnt-4)
      (cons 10  pnt-1)
      (cons 370 sign-thik);толщина линии
    );list
  );entmakex
);setq


(princ)
(gc)
)
