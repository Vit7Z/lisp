;/////// извлекаем данные из объекта для штампа                       //////////////////////////////////////////////////////////////////////
;/////// ************************************************************ //////////////////////////////////////////////////////////////////////
(defun 101-00-spcf-pages-take-data-stamp

(data-obj / type-obj)

(if (/= data-obj nil)
	(progn
		(setq data-obj (entget (ssname data-obj 0))
		      type-obj (cdr (assoc 0 data-obj))
		);setq
  
  	(if (= type-obj "TEXT")
  		(setq data-txt (list (assoc 0 data-obj) (assoc 40 data-obj) (assoc 41 data-obj) (assoc 1 data-obj)));setq
  	);if
  
  	(if (= type-obj "MTEXT")
  		(setq data-txt (list (assoc 0 data-obj) (assoc 40 data-obj) (assoc 41 data-obj) (assoc 1 data-obj)));setq
  	);if

	);progn 
);if

(if (= data-obj nil) (setq data-txt nil))

)

