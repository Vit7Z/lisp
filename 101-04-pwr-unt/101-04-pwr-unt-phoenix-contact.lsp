(defun but1-101-04-pwr-unt-phoenix-contact

( / str-01 str-02 str-03 str-04 str-05 str-06 str-99 swtch tmp-list-902)

(setq str-01 (nth (atoi (get_tile "txt-01")) list-01)
			str-02 (nth (atoi (get_tile "txt-02")) list-02)
			str-03 (nth (atoi (get_tile "txt-03")) list-03)
			str-04 (nth (atoi (get_tile "txt-04")) list-04)
			str-05 (nth (atoi (get_tile "txt-05")) list-05)
			str-06 (nth (atoi (get_tile "txt-06")) list-06)
			str-99 (nth (atoi (get_tile "txt-08")) list-08)
);setq

(if (/= list-901 nil) (setq list-902 (reverse list-902)));if

;;;;;;;/////////////////////////////////////////////////////////////////////////////////////////////
(if (= str-01 "QUINT POWER")
	(progn		
		(setq list-901 (vl-list* (strcat str-01 "  Uвход " 
																		 str-02 "В  Iнагр " 
																		 str-04 "А  "
																		 str-05 "  Артикул "
																		 str-06) list-901)
  	
					tmp-list-902 (list (cons 1 str-01) (cons 2 str-02) (cons 3 str-03) (cons 4 str-04) (cons 5 str-05) (cons 6 str-06) (cons 99 str-99))
					
		);setq
	);progn	
);if

;;;;;;;/////////////////////////////////////////////////////////////////////////////////////////////
(if (= str-01 "QUINT DIODE")
	(progn		
		(setq list-901 (vl-list* (strcat str-01 "  Uвход " 
																		 str-02 "В  Iвход " 
																		 str-03 "А  Iвыход "
																		 str-04 "A  Артикул "
																		 str-06) list-901)
  	
				tmp-list-902 (list (cons 1 str-01) (cons 2 str-02) (cons 3 str-03) (cons 4 str-04) (cons 5 str-05) (cons 6 str-06) (cons 99 str-99))
		);setq
	);progn	
);if

(setq list-902 (vl-list* tmp-list-902 list-902)
			list-902 (reverse list-902)
);setq

(list-filling "txt-901" (reverse list-901))

(princ)
)
