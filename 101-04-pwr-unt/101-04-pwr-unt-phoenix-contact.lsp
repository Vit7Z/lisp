(defun spcf-101-04-pwr-unt-phoenix-contact

( / cntr-1 pnt-ins str-01 str-02 str-03 str-04 str-05 str-06 str-701 str-702 str-99 str-crtf str-manufact str-order str-tmp str-unit)

(setq cntr-1 0);setq

(repeat (length list-902)
	(setq str-tmp (nth cntr-1 list-902)
				str-01 (cdr (assoc 1 str-tmp))
				str-02 (cdr (assoc 2 str-tmp))
				str-03 (cdr (assoc 3 str-tmp))
				str-04 (cdr (assoc 4 str-tmp))
				str-05 (cdr (assoc 5 str-tmp))
				str-06 (cdr (assoc 6 str-tmp))
				str-99 (cdr (assoc 99 str-tmp))
	);setq
	
	(setvar "osmode" 6199)
	
	(setq pnt-ins (getpoint "\nУкажите точку вставки\n"));setq

	;/////////////////////////////////////////////////////////////////////////////////////////////////
	(if (= "QUINT POWER" str-01)
		(setq str-701 "Блок питания"
			
					str-702 (list (cons 1 (strcat "Uвход " str-02 "В, Uвыход " str-03 "В, Iнагр " str-04 "А")));list
															
					str-order (list (cons 1 (strcat str-05 ", артикул " str-06)) 
													(cons 2 ",") 
													(cons 3 nil));list
						
					str-unit "шт"
			);setq
	);if

	;/////////////////////////////////////////////////////////////////////////////////////////////////
	(if (= "QUINT DIODE" str-01)
		(setq str-701 "Диодный модуль"
			
					str-702 (list (cons 1 (strcat "Uвход "str-02 "В, Iвход " str-03 "А, Iвыход " str-04 "А")));list
															
					str-order (list (cons 1 (strcat str-05 ", артикул " str-06)) 
													(cons 2 "/") 
													(cons 3 nil));list
						
					str-unit "шт"
			);setq
	);if

	(setq str-manufact "Phoenix Contact"
				str-crtf nil
	);setq
			
	(split-str-parts-spcf-01-general str-701 str-702 str-order str-manufact str-unit str-99 str-crtf pnt-ins)

	(setq cntr-1 (+ cntr-1 1));setq
);repeat

(princ)
)
