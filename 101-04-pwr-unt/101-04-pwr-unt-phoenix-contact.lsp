(defun start-101-04-pwr-unt-phoenix-contact

( / list-01-read-file list-02-read-file list-03-read-file list-04-read-file list-05-read-file list-06-read-file list-07-read-file)

(if (= nil str-01) 
	(setq str-01 (nth 0 list-01));setq
	(setq str-01 (nth (atoi (get_tile "txt-01")) list-01));setq
);if

(cond
	((= str-01 "QUINT POWER")
		(set_tile "ptxt-031" "Uвыход,")
		(set_tile "ptxt-032" "В")
		(set_tile "ptxt-041" "Iнагр,")
		(set_tile "ptxt-042" "А")
		(set_tile "ptxt-071" "Развязка")
		(set_tile "ptxt-072" "каналов")
	);=

	((= str-01 "QUINT DIODE")
		(set_tile "ptxt-031" "Iвход,")
		(set_tile "ptxt-032" "A")
		(set_tile "ptxt-041" "Iвыход,")
		(set_tile "ptxt-042" "А")
		(set_tile "ptxt-071" "")
		(set_tile "ptxt-072" "")
	);=
);cond


(cond
	((= str-01 "QUINT POWER")
		(read-file-for-dialog-box "101-04-pwr-unt-phoenix-contact-quint-power.txt" 7)
	);=

	((= str-01 "QUINT DIODE")
		(progn
			(read-file-for-dialog-box "101-04-pwr-unt-phoenix-contact-quint-diode.txt" 6)
			(setq list-07-read-file list-06-read-file
						list-06-read-file nil
			);setq
		);progn
	);=
);cond

(setq list-02 list-01-read-file
			list-03 list-02-read-file
			list-04 list-03-read-file
			list-05 list-04-read-file
			list-06 list-05-read-file
			list-07 list-06-read-file
			list-08 list-07-read-file
);setq

(list-filling "txt-02" list-02)
(list-filling "txt-03" list-03)
(list-filling "txt-04" list-04)
(list-filling "txt-05" list-05)
(list-filling "txt-06" list-06)
(list-filling "txt-07" list-07)
(list-filling "txt-08" list-08)

(set_tile "txt-02" "0")
(set_tile "txt-03" "0")
(set_tile "txt-04" "0")
(set_tile "txt-05" "0")
(set_tile "txt-06" "0")
(set_tile "txt-07" "0")
(set_tile "txt-08" "0")





(princ)
)
