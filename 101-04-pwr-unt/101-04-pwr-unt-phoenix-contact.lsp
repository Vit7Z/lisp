;;;;/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
;;;;подпрограмма вывода в ПЭ                   //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
(defun le-101-04-pwr-unt-phoenix-contact

( / cntr-1 pnt-ins str-01 str-02 str-03 str-04 str-05 str-06 str-701 str-702 str-tmp)

(setq cntr-1 0);setq

(repeat (length list-902)
	(setq str-tmp (nth cntr-1 list-902)
				str-01 (cdr (assoc 1 str-tmp))
				str-02 (cdr (assoc 2 str-tmp))
				str-03 (cdr (assoc 3 str-tmp))
				str-04 (cdr (assoc 4 str-tmp))
				str-05 (cdr (assoc 5 str-tmp))
				str-06 (cdr (assoc 6 str-tmp))
	);setq
	
	(setvar "osmode" 6199)
	
	(setq pnt-ins (getpoint "\nУкажите точку вставки\n"));setq
	
	;;;;////////////////////////////////////////////////////////////////////////
	(if (= str-01 "QUINT POWER")
		(setq str-701 (strcat "Блок питания Phoenix Contact, " str-05 ", артикул " str-06 ", Uвход " str-02 "В, Uвыход " str-03 "В, Iнагр " str-04 "А")
					str-702 nil
		);setq
	);if

	;;;;////////////////////////////////////////////////////////////////////////
	(if (= str-01 "QUINT DIODE")
		(setq str-701 (strcat "Диодный модуль Phoenix Contact, " str-05 ", артикул " str-06 ", Uвход "str-02 "В, Iвход " str-03 "А, Iвыход " str-04 "А")
					str-702 nil
		);setq
	);if
	
	(split-str-parts-le-01-general str-701 str-702 pnt-ins);
	
	(setq cntr-1 (1+ cntr-1));счетчик
);repeat

(princ)
)
