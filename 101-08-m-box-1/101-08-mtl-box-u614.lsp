;;;;////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
;;;;подпрограмма вывода в ПЭ                   /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
(defun le-101-08-mtl-box-u614

(list-902 / cntr-1 pnt-ins str-01 str-02 str-03 str-04 str-701 str-702 str-tmp)

(setq cntr-1 0);setq

(repeat (length list-902)
	(setq str-tmp (nth cntr-1 list-902)
				str-01 (cdr (assoc 1 str-tmp))
				str-02 (cdr (assoc 2 str-tmp))
				str-03 (cdr (assoc 3 str-tmp))
				str-04 (cdr (assoc 4 str-tmp))
	);setq
		
	(if (wcmatch str-04 "IP*") (setq str-04 (strcat "степень защиты " str-04)));if
	
	(setvar "osmode" 6199)
	
	(setq pnt-ins (getpoint "\nУкажите точку вставки\n")
				str-701 (strcat "Коробка зажимов " str-01 ", " str-02 " клемм, кол. сальников: " str-03 ", " str-04)
				str-702 nil
	);setq
		
	(split-str-parts-le-01-general str-701 str-702 pnt-ins);
	
	(setq cntr-1 (1+ cntr-1));setq
);repeat

(princ)
)
;;;;///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
;;;;///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


;;;;////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
;;;;подпрограмма вывода в СПЦФ                 /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
(defun spcf-101-08-mtl-box-u614

(list-902 / cntr-1 pnt-ins str-01 str-02 str-03 str-04 str-041 str-701 str-702 str-99 str-crtf str-manufact str-order str-tmp str-unit)

(setq cntr-1 0);setq

(repeat (length list-902)
	(setq str-tmp (nth cntr-1 list-902)
				str-01 (cdr (assoc 1 str-tmp))
				str-02 (cdr (assoc 2 str-tmp))
				str-03 (cdr (assoc 3 str-tmp))
				str-04 (cdr (assoc 4 str-tmp))
				str-99 (cdr (assoc 99 str-tmp))
	);setq

	(setvar "osmode" 6199)

	(cond
		((wcmatch str-04 "IP*") (setq str-041 (strcat "степень защиты " str-04 " по ГОСТ 14254")));
	);if

	(setq pnt-ins (getpoint "\nУкажите точку вставки\n")	
				str-unit "компл."
				str-701 "Коробка соединительная"
				str-702 (list (cons 1 (strcat "кол. клемм " str-02))
											(cons 2 (strcat "кол. сальников: " str-03))
											(cons 3 str-041))
				
				str-order (list (cons 1 (strcat str-01 " " str-04)) 
												(cons 2 nil) 
												(cons 3 "ТУ 3434-002-01395331-2006"));list
				
				str-manufact "ОАО \"КЗЭИ\", г. Новосибирск"
				str-crtf nil
	);setq
	
	(split-str-parts-spcf-01-general str-701 str-702 str-order str-manufact str-unit str-99 str-crtf pnt-ins);

	(setq cntr-1 (+ cntr-1 1));setq
);repeat
	

(princ)
)
