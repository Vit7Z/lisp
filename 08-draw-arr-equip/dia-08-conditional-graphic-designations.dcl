dia_cond_graphic_design: dialog {label = "Условные графические обозначения ЧРО";

:column {
  :row {label=""; height=1;}//row
  :toggle {label="Шапка таблицы";                                   															key="txt-00"; list=""; height=1; value=0; fixed_width_font=true;}//toggle
  :toggle {label="Отборное устройство (закладная конструкция)";                                   key="txt-01"; list=""; height=1; value=0; fixed_width_font=true;}//toggle
  :toggle {label="Прибор, установленный по месту";                                                key="txt-02"; list=""; height=1; value=0; fixed_width_font=true;}//toggle
  :toggle {label="Обозначение кабеля по схеме (схемам) соединений внешних проводок";              key="txt-03"; list=""; height=1; value=0; fixed_width_font=true;}//toggle
  :toggle {label="Коробка соединительная";                                                        key="txt-04"; list=""; height=1; value=0; fixed_width_font=true;}//toggle
  :toggle {label="Проводка(и) в патрубке через стену";                                            key="txt-05"; list=""; height=1; value=0; fixed_width_font=true;}//toggle
  :toggle {label="Проводка уходит на более высокую отметку";                                      key="txt-06"; list=""; height=1; value=0; fixed_width_font=true;}//toggle
  :toggle {label="Проводка приходит с более низкой отметки";                                      key="txt-07"; list=""; height=1; value=0; fixed_width_font=true;}//toggle
  :toggle {label="Проводка уходит на более низкую отметку";                                       key="txt-08"; list=""; height=1; value=0; fixed_width_font=true;}//toggle
  :toggle {label="Проводка приходит с более высокой отметки";                                     key="txt-09"; list=""; height=1; value=0; fixed_width_font=true;}//toggle
  :toggle {label="Проводки проложить в полу (под площадкой) в трубе";                             key="txt-10"; list=""; height=1; value=0; fixed_width_font=true;}//toggle
  :toggle {label="Проводки проложить в трубе";                                                    key="txt-11"; list=""; height=1; value=0; fixed_width_font=true;}//toggle
  :toggle {label="Проводки проложить в лотке (коробе) с крышкой";                                 key="txt-12"; list=""; height=1; value=0; fixed_width_font=true;}//toggle
  :toggle {label="Проводки проложить в швеллере перфорированном";                                 key="txt-13"; list=""; height=1; value=0; fixed_width_font=true;}//toggle
  :toggle {label="Шкаф (щит, панель) одностороннего обслуживания"; key="txt-14"; list=""; height=1; value=0; fixed_width_font=true;}//toggle
  :toggle {label="Шкаф (щит) двустороннего обслуживания"; key="txt-15"; list=""; height=1; value=0; fixed_width_font=true;}//toggle
  :row {label=""; height=1;}//row
}//column

ok_cancel;
}
