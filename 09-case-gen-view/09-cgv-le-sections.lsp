(defun txt-01-09-cgv-le-sections

(str-01 list-02-read-file / list-900-read-file)

(setq list-02 (nth (atoi str-01) list-02-read-file));setq

(divide-text-into-parts list-02 53)

(setq list-02 list-900-read-file);setq

(list-filling "txt-02" list-02)

(princ)
)
