(defun c:09-cgv-le-sections

( / adoc dcl-id list-01 list-01-read-file list-02 list-02-read-file str-01)

(vl-load-com)
(vla-startundomark (setq adoc (vla-get-activedocument (vlax-get-acad-object))));start undo

(09-cgv-le-empty-line-02)

(read-file-for-dialog-box-01 "09-cgv-le-sections.txt" 2);setq

(setq str-01 "0"		
			list-01 list-01-read-file
);setq

(txt-01-09-cgv-le-sections str-01 list-02-read-file)

(if (< (setq dcl-id (load_dialog "dia-09-cgv-le-sections.dcl")) 0) ;ищем диалог
	(progn
		(alert "Не найден dcl-файл")
		(exit)
	);progn
);if

(if (not (new_dialog "dia_09_cgv_le" dcl-id))
		(exit)
);if

(list-filling "txt-01" list-01)
(list-filling "txt-02" list-02)

(set_tile "txt-01" "0")

(action_tile "txt-01"
  (strcat "(setq str-01 (get_tile \"txt-01\"))"
					"(txt-01-09-cgv-le-sections str-01 list-02-read-file)"
  );strcat
);action_tile

(action_tile "accept"
  (strcat "(setq str-01 (get_tile \"txt-01\"))"
  				"(done_dialog)"
  );strcat
);action_tile

(start_dialog)
(unload_dialog dcl-id)

(01-09-cgv-le-sections str-01 list-01-read-file)

(vla-endundomark adoc)	

(setvar "osmode" 6199)
(setvar "cmdecho" 1)
(setvar "orthomode" 1)

(princ)
)
