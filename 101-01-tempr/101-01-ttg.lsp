;;;;/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
;;;;подпрограмма формирования данных/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
(defun filling-fields-101-01-tmprt-sens-ttg

( / cntr-1 str-01 str-02 str-03 str-04 str-05 str-06 str-902 str-99 swtch)

;заполняем поле "выбрано"
(setq str-01 (nth (atoi (get_tile "txt-01")) list-01)
			str-02 (nth (atoi (get_tile "txt-02")) list-02)
			str-03 (nth (atoi (get_tile "txt-03")) list-03)
			str-04 (nth (atoi (get_tile "txt-04")) list-04)
			str-05 (nth (atoi (get_tile "txt-05")) list-05)
			str-06 (nth (atoi (get_tile "txt-06")) list-06)
      swtch list-901 ;запоминаем первоначальное состояние списка в поле "выбрано"
      cntr-1 0 ;счетчик, номер элемента в списке
);setq

(if (/= swtch nil);если есть уже выбраннное то переворачиваем
	(setq list-902 (reverse list-902)
				list-901 (reverse list-901)
	);setq
);if

(setq str-99
	(cond	
		((= str-01 "ТТЖ-М исп. 1П") "0,1")
		
		
	);cond
);setq

(if (= str-01 "ТТЖ-М исп. 1П")
	(setq str-902 (list (cons 1 str-01) (cons 2 str-02) (cons 3 str-03) (cons 4 str-04) (cons 5 str-05) (cons 6 str-06) (cons 99 str-99))
				list-902 (vl-list*  str-902 list-902);список характеристик для спецификации
				list-901 (vl-list* (strcat str-01 "  " 
																	 str-02 "°С  " 
																	 "№" str-03 "  " 
																	 "Цена деления " str-04 "°С  " 
																	 "Длина верхней части " str-05 "мм  " 
																	 "Длина нижней части " str-06 "мм") list-901)
	);setq
);if

(if (= swtch nil)
	(setq list-902 (reverse list-902)
				list-901 (reverse list-901)
	);setq
);if

(if (/= swtch nil)
	(setq list-902 (reverse list-902)
				list-901 (reverse list-901)
	);setq
);if

(list-filling "txt-901" list-901)

(princ)
)
