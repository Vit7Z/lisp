);if

(list-filling "txt-01" list-01)
(list-filling "txt-02" list-02)
(list-filling "txt-03" list-03)
(list-filling "txt-04" list-04)
(list-filling "txt-05" list-05)
(list-filling "txt-06" list-06)
(list-filling "txt-07" list-07)

(set_tile "txt-01" "0")
(set_tile "txt-02" "0")
(set_tile "txt-03" "0")
(set_tile "txt-04" "0")
(set_tile "txt-05" "0")
(set_tile "txt-06" "0")

(action_tile "txt-01" ;выбор
  (strcat "(start-101-01-tmprt-sens-ttg)");strcat
);action_tile

(action_tile "txt-02" ;выбор
  (strcat "(txt-02-101-01-tmprt-sens-ttg)"
  				"(set_tile \"txt-03\" (get_tile \"txt-02\"))"
  );strcat
);action_tile

(action_tile "txt-03" ;выбор
  (strcat "(set_tile \"txt-02\" (get_tile \"txt-03\"))"
  				"(txt-02-101-01-tmprt-sens-ttg)"
  );strcat
);action_tile

(action_tile "txt-04" ;выбор
  (strcat "(txt-04-101-01-tmprt-sens-ttg)");strcat
);action_tile

