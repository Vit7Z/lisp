;;;;/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
;;;;подпрограмма вывода в ПЭ                   //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
(defun le-101-termo-tpt1

( / cntr-1 str-01 str-txt tmp tmp-1 tmp-2 tmp-4 tmp-5 tmp-6 tmp-99)

(setq cntr-1 0);setq

(repeat (length list-902)
	(setq tmp (nth cntr-1 list-902)
				tmp-1 (cdr (assoc 1 tmp))
				tmp-2 (cdr (assoc 2 tmp))
				tmp-4 (cdr (assoc 4 tmp))
				tmp-5 (cdr (assoc 5 tmp))
				tmp-6 (cdr (assoc 6 tmp))
	);setq

	(setvar "osmode" 6199)
	
	(setq pnt-ins		(getpoint "\nУкажите точку вставки\n"));setq
	
	(100-empt-lin-le)
	
	;///////////////////////////////////////////////////////////////////
	(if (= tmp-1 "ТТЖ-М исп. 1П")
		(setq str-txt (strcat "Термометр технический жидкостной ТТЖ-М, исп. 1, прямой, предел изм. "
													tmp-2 "%%dС, L верхней части " tmp-5 "мм, L нижней части " tmp-6 "мм")
		);setq
	);if

	(split-str-parts-le-110-01 str-txt pnt-ins)

	(setq cntr-1 (1+ cntr-1));setq
);repeat

(princ)
)
