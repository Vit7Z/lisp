      counter 0
      
      list-01 (list "ТТЖ-М исп. 1П")
			list-02 nil
			list-03 nil
			list-04 nil
			list-05 nil
			list-06 nil
			list-07 nil
			
			list-901 nil
			list-902 nil
			
			str-01 nil
);setq

