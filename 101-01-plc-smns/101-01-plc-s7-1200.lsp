);action_tile

(action_tile "accept"
  (strcat "(done_dialog)"
          "(exit)"
  );strcat
);action_tile

(start_dialog)
(unload_dialog dcl-id)

(cond
	((= type-list "le") (le-101-01-plc-s7-1200));=
	((= type-list "spcf") (spcf-101-01-plc-s7-1200));=
	((= type-list "lecgv") (lecgv-101-01-plc-s7-1200));=
);cond

(setvar "osmode" 6199)
(setvar "cmdecho" 1)
(vla-endundomark adoc)
