(defun but1-101-01-plc-s7-1200

( / str-01 str-02 str-03 str-04 str-99 str-chnls str-prfx tmp-str-902)

(setq str-01 (nth (atoi (get_tile "txt-01")) list-01)
			str-02 (nth (atoi (get_tile "txt-02")) list-02)
			str-03 (nth (atoi (get_tile "txt-03")) list-03)
			str-04 (nth (atoi (get_tile "txt-04")) list-04)
			str-99 (nth (atoi (get_tile "txt-99")) list-99)
			str-prfx "S7-1200"
			str-chnls "каналов"
);setq

(if (or (= str-03 "4") (= str-03 "32") (= str-03 "24"))
	(setq str-chnls "канала"
	);setq
);if

(if (/= list-901 nil) 
	(setq list-901 (reverse list-901)
				list-902 (reverse list-902)
	);setq
);if

;;;;;;;;////////////////////////////////
(if (= str-01 "Процессор")
	(setq list-901 (vl-list* (strcat str-02 "  Uпит. " str-03 "  " str-04) list-901)
				tmp-str-902 (list (cons 1 str-01) 
													(cons 2 (strcat str-prfx " " str-02)) 
													(cons 3 str-04) 
													(cons 99 str-99))	
	);setq
);if

;;;;;;;;////////////////////////////////
(if (or (= str-01 "Модуль A-in")
		  	(= str-01 "Модуль A-out")
		  	(= str-01 "Модуль D-in")
		  	(= str-01 "Модуль D-out"));or
	
	(setq list-901 (vl-list* (strcat str-01 "  " str-02 "  " str-03 " " str-chnls " (" str-04 ")") list-901)
				tmp-str-902 (list (cons 1 str-01)
													(cons 2 (strcat str-prfx " " str-02)) 
													(cons 3 (strcat str-03 " " str-chnls " (" str-04 ")"))
													(cons 99 str-99))
	);setq
);if

;;;;;;;;////////////////////////////////
(if (= str-01 "Карта памяти")
	(setq list-901 (vl-list* (strcat str-01 "  " str-02 "  Объем " str-03) list-901)
				tmp-str-902 (list (cons 1 str-01) 
													(cons 2 str-02) 
													(cons 3 str-03) 
													(cons 99 str-99))
	);setq
);if

;;;;;;;;////////////////////////////////
(if (= str-01 "Модуль коммуникационный")
	(setq list-901 (vl-list* (strcat str-01 "  " str-02 "  " str-04) list-901)
				tmp-str-902 (list (cons 1 str-01) 
													(cons 2 (strcat str-prfx " " str-02)) 
													(cons 3 str-04) 
													(cons 99 str-99))
	);setq
);if

(setq list-902 (vl-list* tmp-str-902 list-902)
			list-901 (reverse list-901)
			list-902 (reverse list-902)
);setq

(list-filling "txt-901" list-901)

(princ)
)
